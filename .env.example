# ============================================================
# AOPSTSMA Apex Portal — Environment Variables Template
# Copy this file to `.env.local` for local development
# In production (Vercel), add these in the Vercel Dashboard
# ============================================================

# 1. Supabase (Postgres, Auth, RLS)
# Transaction Pooler port 6543 must be used for serverless functions (SPEC.md §2)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# 2. Razorpay Payment Gateway (SPEC.md §5 & §6)
# Get keys from Razorpay Dashboard -> Settings -> API Keys (Test or Live)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=yourRazorpayKeySecretHere
RAZORPAY_WEBHOOK_SECRET=yourRazorpayWebhookSecretHere

# 3. Google Sheets Integration Webhook (SPEC.md §8)
# Deploy Google Apps Script as Web App and paste URL here
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/your-google-apps-script-id/exec

# 4. App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
