c:["$","$1","c",{"children":[[["$","section",null,{"className":"page-head","children":["$","div",null,{"className":"wrap","children":[["$","h1",null,{"children":"Forty-five years of standing for private training schools"}],["$","p",null,{"className":"lede","children":"What the association is, why it was formed, and who runs it."}]]}]}],["$","section",null,{"className":"section","children":["$","div",null,{"className":"wrap","style":{"maxWidth":"820px"},"children":[["$","div",null,{"className":"stack reveal","children":[["$","p",null,{"children":"The association was formed in 1980, when private secondary training schools across Odisha found that decisions affecting every one of them were being taken without anyone in the room to speak for them. Individually, a school in Derabis or Saleibahal had little chance of being heard. Collectively, they could be."}],["$","p",null,{"children":"Since then the association has done three things: represented member schools in court, kept them informed of orders and departmental letters that affect their recognition, and put their case to the School and Mass Education Department and the Board of Secondary Education."}],["$","p",null,{"children":"Member schools are organised into six zones covering the state. Each zone maintains its own list of schools, and zone representatives carry local matters to the association office."}]]}],["$","div",null,{"className":"head reveal","style":{"marginTop":"4rem"},"children":[["$","div",null,{"className":"head__rule"}],["$","h2",null,{"children":"Office bearers"}]]}],["$","div",null,{"className":"bearers reveal","children":[["$","div",null,{"className":"bearer","children":[["$","span",null,{"children":"President"}],["$","h3",null,{"children":"Nirmal Kant Mohanty"}]]}],["$","div",null,{"className":"bearer","children":[["$","span",null,{"children":"Secretary"}],["$","h3",null,{"children":"Aba Pradhan"}]]}]]}],["$","div",null,{"className":"note reveal","style":{"marginTop":"3rem"},"children":"The full list of zone representatives and executive committee members is being compiled. Member schools can reach the association office on 63709 87576 in the meantime."}]]}]}]],null,["$","$Lf",null,{"children":["$L10",["$","$L11",null,{"promise":"$@12"}]]}]]}]
